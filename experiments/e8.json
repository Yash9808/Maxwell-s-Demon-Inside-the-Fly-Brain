{
  "id": "e8",
  "manifest_version": 1,
  "source_of_truth": "experiment_worker.js EXPERIMENTS.e8 + documented constants in experiment_core.js",
  "label": "E8 \u00b7 Information-Limited Demons",
  "question": "What is the behavioral price of less measurement/memory (adaptive vs fixed vs mem4)?",
  "needs_circuit": false,
  "dataset": null,
  "physics": {
    "chamber": {
      "w": 760,
      "h": 380,
      "d": 300
    },
    "wall_thickness": 8,
    "door_gap": 0.6,
    "door_z_half": 105.0,
    "pmass_cap": 600,
    "dt_s": 0.016666666666666666,
    "env_defaults": {
      "nParticles": 320,
      "noise": 0.12,
      "doorHeight": 64,
      "jetPower": 0.55,
      "jetAim": 0.5,
      "jetInterval": 3.5
    },
    "thermo": {
      "sim_to_joule": 1e-21,
      "T_env_K": 300,
      "kB_J": 1.38e-23
    },
    "seed_scheme": "env seed = 1 + seedIdx*101; controller rng = makeRng(seed ^ 0x5f5f)"
  },
  "controllers": {
    "demon_adaptive": {
      "type": "classicalDemon",
      "params": {
        "adaptive": true
      }
    },
    "demon_fixed": {
      "type": "classicalDemon",
      "params": {
        "adaptive": false
      }
    },
    "demon_mem4": {
      "type": "classicalDemon",
      "params": {
        "memSize": 4
      }
    }
  },
  "reward_parameters": null,
  "seed": {
    "prng": "mulberry32 (experiment_core.js makeRng); seed = 1 + seedIdx*101",
    "n_seeds": 2
  },
  "train_test_split": {
    "train_trials": 60,
    "test_trials": 12,
    "episode_seconds": 12,
    "learning_on": "train phase only"
  },
  "expected_outputs": {
    "conditions": [
      "demon_adaptive",
      "demon_fixed",
      "demon_mem4"
    ],
    "rows": "one JSONL/row per condition\u00d7phase\u00d7trial\u00d7seed (schema identical to research_data/ rows; see run_smoke.js field assertions)",
    "summary": "per-condition mean\u00b1CI block aggregates (early/late/test windows)",
    "provenance": "run provenance echo (seeds, trials, physics, software tag, timestamps)"
  }
}
