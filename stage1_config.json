{
  "configVersion": 1,
  "stage": 1,
  "protocol": {
    "document": "Confirmatory_experiment_protocol_v1.md",
    "version": "v1.1",
    "status": "Stage 1 EXPLORATORY (protocol §7); pilot-prohibition lock per §13"
  },
  "runtime": {
    "engine": "experiment_core.js",
    "driver": "benchmark.js --config stage1_config.json",
    "note": "Headless designated runtime only (protocol §2). The browser 3D app is visualization, never evidence generation."
  },
  "physics": {
    "dt": 0.016666666666666666,
    "nParticles": 320,
    "noise": 0.12,
    "doorHeight": 64,
    "jetPower": 0.55,
    "jetAim": 0.5,
    "jetInterval": 3.5,
    "tKelvin": 300,
    "simToJoule": 1e-21,
    "landauerBitJ": 2.871e-21,
    "lr": 0.004,
    "lrNote": "dopamine-gated plasticity rate in connectomeController.applyLearning; setLearning(false) phases ignore it; per-arm override allowed via arms.*.lr"
  },
  "phases": {
    "pre": { "trials": 1, "episodeSeconds": 120, "learning": false, "frozen": true },
    "train": { "trials": 300, "episodeSeconds": 12, "learning": true },
    "post": { "trials": 60, "episodeSeconds": 12, "learning": false }
  },
  "frozenPreSeconds": 120,
  "arms": {
    "armA_real_connectome": { "kind": "connectome", "shuffle": false, "plasticity": "full", "opticDrive": 0.25, "opticInput": "legacy8bin" },
    "armB_restricted_connectome": { "kind": "connectome", "shuffle": false, "plasticity": "restricted", "opticDrive": 0.25, "opticInput": "legacy8bin" },
    "armC_degree_preserved_shuffle": { "kind": "connectome", "shuffle": true, "plasticity": "full", "opticDrive": 0.25, "opticInput": "legacy8bin" },
    "armD_matched_random_sparse": { "kind": "connectome", "shuffle": false, "plasticity": "full", "customEdges": "degreeMatchedRandomEdges", "swapFactor": 10, "opticDrive": 0.25, "opticInput": "legacy8bin" },
    "armE_random_action_floor": { "kind": "random", "policy": "randomActionFloor" }
  },
  "seedTable": {
    "note": "Protocol §6c authoritative table. environmentSeed = 4101 + (k-1)*101; networkSeed = 9201 + (k-1)*101; topologySeed = 7000 + k (independent stream; drives arm C shuffle AND arm D draw). Stage 1 consumes pairs 1-3 (§6c); rows 4-8 pre-drawn reserve.",
    "seedStride": 101,
    "consumedPairs": 3,
    "pairs": [
      { "k": 1, "environmentSeed": 4101, "networkSeed": 9201, "topologySeed": 7001 },
      { "k": 2, "environmentSeed": 4201, "networkSeed": 9302, "topologySeed": 7002 },
      { "k": 3, "environmentSeed": 4301, "networkSeed": 9403, "topologySeed": 7003 },
      { "k": 4, "environmentSeed": 4401, "networkSeed": 9504, "topologySeed": 7004 },
      { "k": 5, "environmentSeed": 4501, "networkSeed": 9605, "topologySeed": 7005 },
      { "k": 6, "environmentSeed": 4601, "networkSeed": 9706, "topologySeed": 7006 },
      { "k": 7, "environmentSeed": 4701, "networkSeed": 9807, "topologySeed": 7007 },
      { "k": 8, "environmentSeed": 4801, "networkSeed": 9907, "topologySeed": 7008 }
    ]
  },
  "analysis": {
    "script": "stage1_analyze.js",
    "endpoint": "deltaSortEntropy_post_minus_pre",
    "contrasts": "seed-paired arm deltas A-D (primary candidate), A-B, A-C (secondary); no p-values in Stage 1 (exploratory, §7)",
    "selectivityDiagnostics": ["deltaGoodBadRatio", "deltaDTfinal", "deltaDemonAgree"],
    "thermoTrack": "separate (protocol §15); recorded in rows, never mixed into the behavioral endpoint"
  },
  "matchTest": {
    "file": "tests/stage1_arm_d_match.test.js",
    "requirement": "green BEFORE pre-registration pin (protocol §5d/§13)"
  },
  "preRegistration": {
    "file": "PRE_REGISTRATION_STAGE1.json",
    "pinBeforeAnySimulation": true
  }
}
