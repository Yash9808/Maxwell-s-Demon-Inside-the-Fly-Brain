"use strict";
// Diagnostic (not tuning): why is the 24-episode test-vs-train delta CI-wide?
//  D1 per-seed |P(release) test - train| ("policy move") vs the test-train
//     reward delta — if movement and delta correlate, stall-vs-noise is the axis.
//  D2 within-train slope: mean(last 8 train eps) - mean(first 8 train eps) —
//     a pure within-brain contrast with no phase-confound.
//  D3 decision count per seed (event-locked): is the PG update even firing?
const { smoluchowskiCore, makeRng } = require("./experiment_core.js");
const { connectomeController } = require("./controllers.js");
const circuit = require("./fly_brain_circuit.json");

const SEEDS = Number(process.argv[2]) || 10;
const EP = 12, TR = 24, TT = 8;
const mean = a => a.reduce((x, y) => x + y, 0) / a.length;

const BASE = process.argv[3] === "baseline";   // node _diag_e10batch.js [seeds] [legacy|baseline]
const rows = [];
for (let s = 1; s <= SEEDS; s++) {
  const out = [];
  smoluchowskiCore({
    seed: s, seedTag: s, trials: TR + TT, trainTrials: TR, episodeSeconds: EP,
    nParticles: 220, brainFactory: () => connectomeController(circuit, {
      shuffle: false, rng: makeRng(1000 + s), seed: 1, opticDrive: 0,
      motorDrive: 0.6, plasticity: "full",
      eligibility: [{ tau: 0.90, w: 0.45 }, { tau: 0.985, w: 0.35 }, { tau: 0.9995, w: 0.20 }],
      policyGradient: true, pgBaseline: BASE, pgRng: makeRng(500000 + s),
    }),
    onTrialData: (c, p, r) => { if (c === "trapdoor_neural") out.push(r); },
  });
  const tr = out.filter(r => r.phase === "train"), te = out.filter(r => r.phase === "test");
  const pgTr = mean(tr.map(r => r.pgReleaseP)), pgTe = mean(te.map(r => r.pgReleaseP));
  const pgEarly = mean(tr.slice(0, 8).map(r => r.pgReleaseP));
  const pgLate  = mean(tr.slice(-8).map(r => r.pgReleaseP));
  const early = mean(tr.slice(0, 8).map(r => r.reward));
  const late  = mean(tr.slice(-8).map(r => r.reward));
  rows.push({
    s,
    delta: mean(te.map(r => r.reward)) - mean(tr.map(r => r.reward)),
    move: Math.abs(pgTe - pgTr),
    slope: late - early,
    pgTr,
    pgDrift: pgLate - pgEarly,          // within-train policy drift (signed)
    accTr: mean(tr.map(r => r.decisionAccuracy)),
    accTe: mean(te.map(r => r.decisionAccuracy)),
  });
  console.log("seed " + String(s).padStart(2) + ":  dReward " + rows[rows.length - 1].delta.toFixed(2).padStart(6) +
    "  P(rel) " + pgEarly.toFixed(2) + "->" + pgLate.toFixed(2) + " (drift " + (pgLate - pgEarly).toFixed(3) + ")" +
    "  trainSlope " + rows[rows.length - 1].slope.toFixed(2).padStart(6) +
    "  acc " + rows[rows.length - 1].accTr.toFixed(2) + "->" + rows[rows.length - 1].accTe.toFixed(2));
}
function corr(a, b) {
  const ma = mean(a), mb = mean(b);
  let num = 0, da = 0, db = 0;
  for (let i = 0; i < a.length; i++) {
    const xa = a[i] - ma, xb = b[i] - mb;
    num += xa * xb; da += xa * xa; db += xb * xb;
  }
  return num / Math.sqrt(da * db || 1e-12);
}
console.log("mode: " + (BASE ? "pgBaseline (per-decision, baseline, zero windows)" : "legacy (per-tick, no baseline)"));
console.log("mean P(rel) drift within train (signed): " + mean(rows.map(r => r.pgDrift)).toFixed(4) +
            "  up in " + rows.filter(r => r.pgDrift > 0.01).length + "/" + rows.length +
            ", down in " + rows.filter(r => r.pgDrift < -0.01).length + "/" + rows.length);
console.log("mean acc train->test: " + mean(rows.map(r => r.accTr)).toFixed(3) + " -> " + mean(rows.map(r => r.accTe)).toFixed(3));
console.log("\ncorr(|policy move|, test-train delta) : " + corr(rows.map(r => r.move), rows.map(r => r.delta)).toFixed(3));
console.log("corr(|policy move|, within-train slope): " + corr(rows.map(r => r.move), rows.map(r => r.slope)).toFixed(3));
console.log("mean within-train slope: " + mean(rows.map(r => r.slope)).toFixed(3) +
            "   slope>0 in " + rows.filter(r => r.slope > 0).length + "/" + rows.length + " seeds");
console.log("seeds with |move|>0.02: " + rows.filter(r => r.move > 0.02).length + "/" + rows.length);
